{
  "name": "summernote-bricks",
  "version": "3.0.0-rc.0",
  "description": "Composable Summernote plugin toolbar for semantic bricks.",
  "type": "module",
  "main": "./dist/summernote-bricks.umd.cjs",
  "module": "./dist/summernote-bricks.js",
  "browser": "./dist/summernote-bricks.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/summernote-bricks.js",
      "require": "./dist/summernote-bricks.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "jquery": ">=3.6.0 <4",
    "summernote": ">=0.9.1 <0.10"
  },
  "keywords": [
    "summernote",
    "summernote-plugin",
    "wysiwyg",
    "editor",
    "bricks"
  ],
  "homepage": "https://github.com/eissasoubhi/summernote-bricks#readme",
  "bugs": "https://github.com/eissasoubhi/summernote-bricks/issues",
  "repository": "https://github.com/eissasoubhi/summernote-bricks",
  "author": "Eissa Soubhi <eissa.soubhi@gmail.com>",
  "license": "MIT"
}

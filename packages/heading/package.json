{
  "name": "summernote-heading",
  "version": "3.0.0-rc.1",
  "private": true,
  "description": "Native Summernote plugin for creating and editing semantic heading blocks.",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "browser": "./dist/index.umd.cjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "peerDependencies": {
    "jquery": ">=3.6.0 <4",
    "summernote": ">=0.9.1 <0.10"
  },
  "keywords": ["summernote", "summernote-plugin", "wysiwyg", "heading", "semantic-html"],
  "homepage": "https://eissasoubhi.github.io/summernote-heading/",
  "bugs": "https://github.com/eissasoubhi/summernote-heading/issues",
  "repository": "https://github.com/eissasoubhi/summernote-heading",
  "author": "Eissa Soubhi <eissa.soubhi@gmail.com>",
  "license": "MIT"
}
